# Public site URL, used for metadata and sitemap generation
NEXT_PUBLIC_SITE_URL=https://www.sagotra.com

# WhatsApp Business number (international format, no "+" or spaces) for inquiry deep links
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# SAGOTRA contact email and Instagram handle (shown in the footer)
NEXT_PUBLIC_CONTACT_EMAIL=hello@sagotra.com
NEXT_PUBLIC_INSTAGRAM_HANDLE=sagotra

# Sanity project (leave blank to keep using local placeholder content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Supabase public credentials used by server-side website lead inserts.
# The anon/publishable key is safe for this use with the narrow crm_leads INSERT RLS policy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
